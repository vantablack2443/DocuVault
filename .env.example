# Copy to .env for running outside docker compose. Compose sets these itself.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://docuvault:docuvault@localhost:5432/docuvault
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
LLM_MODE=replay

# Optional. With LLM_MODE=live and at least one key, the gateway calls real models
# (Gemini first, Groq as fallback). Without keys it answers in replay mode.
# GEMINI_API_KEY=
# GROQ_API_KEY=
