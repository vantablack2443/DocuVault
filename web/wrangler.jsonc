// Cloudflare Worker: serves the built dashboard and forwards /api/* to the API.
// Files in dist are answered by Cloudflare directly; worker.js runs only for
// paths that are not a file.
{
  "name": "docuvault",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "API_ORIGIN": "https://docuvault-api-eqtt.onrender.com"
  },
  // Keep-warm ping (worker.js "scheduled"), every 10 minutes from 07:00 to
  // 20:20 UTC: the API stays up 08:00-21:30 German winter time (07:00-20:30 UTC;
  // in summer time it is 09:00-22:30 local). About 420 container hours a
  // month, inside the free host's 750. Cron times are always UTC.
  "triggers": {
    "crons": ["*/10 7-19 * * *", "0-20/10 20 * * *"]
  },
  // Keeps console.log output (the "keep-warm 200" lines) under Worker → Logs.
  "observability": {
    "enabled": true
  },
  // Preview builds (pull requests) use the same public API. They get no
  // PROXY_SECRET, so the API treats them like any other anonymous caller.
  "previews": {
    "vars": {
      "API_ORIGIN": "https://docuvault-api-eqtt.onrender.com"
    }
  }
  // PROXY_SECRET is set as a secret in the Cloudflare dashboard, never here.
}
